# Supabase — same credentials as the Digital Home
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API key auth for non-session API routes — used by src/lib/api/auth.ts
API_SECRET_KEY=your-api-secret-key
API_SIGNATURE_REQUIRED=true
API_REQUEST_SIGNATURE_TTL_SECONDS=300

# Backblaze B2 — presigned PUT signing for gallery uploads, src/lib/gallery/b2.ts
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=method26-gallery
B2_REGION=us-west-004

# The public site's origin, used by GalleryPanel.tsx to build the
# client-facing link (https://<this>/g/<token>/). Falls back to
# https://method26.com if unset. Build-time (NEXT_PUBLIC_*), same as the
# Supabase pair above — see wrangler.jsonc's `vars` and docs/deploy.md.
NEXT_PUBLIC_SITE_URL=https://method26.com

# Resend — sends a client their gallery link, src/lib/gallery/mail.ts.
# Both fail closed (a thrown error naming the missing one) rather than
# silently no-op. GALLERY_EMAIL_FROM must be a sender on a verified domain
# in Resend, e.g. "method26 Studio <studio@method26.com>".
RESEND_API_KEY=
GALLERY_EMAIL_FROM=
