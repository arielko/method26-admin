# Supabase — same credentials as the Digital Home
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API key auth for non-session API routes — used by src/lib/api/auth.ts
API_SECRET_KEY=your-api-secret-key
API_SIGNATURE_REQUIRED=true
API_REQUEST_SIGNATURE_TTL_SECONDS=300

# Backblaze B2 — presigned PUT signing for gallery uploads, src/lib/gallery/b2.ts
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=method26-gallery
B2_REGION=us-west-004
