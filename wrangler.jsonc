{
  "$schema": "node_modules/wrangler/config-schema.json",
  // worker.ts wraps OpenNext's generated handler purely to re-export the
  // Durable Object classes it generates — see the file header. Reverting to
  // ".open-next/worker.js" is equivalent as long as nothing else is added
  // here.
  "main": "worker.ts",
  "name": "method26-admin",

  // A custom domain, not a route: studio.method26.com has no DNS record, and
  // a custom domain creates and manages one. (The public site uses routes
  // instead, because its records already exist and point at WordPress.)
  "routes": [
    { "pattern": "studio.method26.com", "custom_domain": true }
  ],
  // This worker used to also run a `*/5 * * * *` cron (see worker.ts's old
  // `scheduled` handler) that POSTed to /api/crm/tick and /api/social/tick.
  // Both routes were deleted along with the CRM and social modules on this
  // branch; the cron kept firing regardless, at 288 invocations a day,
  // logging a 404 every time. Removed along with the handler.
  // Keep the workers.dev URL alive; add a custom-domain route here when you
  // claim one, e.g. { "pattern": "backend.yourdomain.com", "custom_domain": true }
  "workers_dev": true,
  "compatibility_date": "2026-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // WORKER_SELF_REFERENCE is OpenNext's own cache-revalidation hook and must
  // name THIS worker. The fork also bound FRONTEND_WORKER to
  // "digital-home-frontend", a worker that does not exist on this account and
  // that nothing in src/ references — removed rather than left to fail at
  // deploy or, worse, to bind to somebody else's worker later.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "method26-admin"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Social media files (videos + carousel slides). Make the bucket public by
  // attaching a custom domain (e.g. media.yourdomain.com) and set
  // R2_PUBLIC_BASE below to match — Meta ingests by pulling that URL, and R2
  // egress is free.
  // The fork bound an R2 bucket for the social module, which this fork
  // deleted. An unused binding is a resource somebody must keep existing.
  "r2_buckets": [],
  "observability": {
    "enabled": true
  },
  // Non-secret env vars, committed plaintext. This is intentional for the
  // three below and only these three:
  //
  //  - NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are
  //    inlined into the client bundle by `next build`, not read from the
  //    Worker at request time — `NEXT_PUBLIC_*` never reaches
  //    `wrangler secret put` at all. login/page.tsx is a client component,
  //    so on a clean checkout or a CI runner without a hand-copied
  //    `.env.local`, `next build` bakes in `undefined` and the deployed
  //    login page fails opaquely. `opennextjs-cloudflare build` reads this
  //    `vars` block and populates the build environment from it before
  //    invoking `next build`, so these values now survive a clean checkout.
  //    An anon key is public by design — the prefix is the promise — so
  //    committing it plaintext costs nothing.
  //  - NEXT_PUBLIC_SITE_URL is read by GalleryPanel.tsx to build the
  //    client-facing link; same build-time inlining applies.
  //
  // Everything else (SUPABASE_SERVICE_ROLE_KEY, B2_KEY_ID, B2_APP_KEY, and
  // the rest) is read via `process.env` at request time inside Worker code
  // and belongs in `wrangler secret put`, never here. A missing one there
  // fails closed with a configuration error.
  // An EMPTY crons list, stated explicitly. Deleting the "triggers" block
  // from this file does not remove a schedule already registered on the
  // deployed Worker — it simply stops mentioning it, and the old cron keeps
  // firing. The fork's every-five-minutes trigger survived that way and was
  // still throwing "Handler does not export a scheduled() function" 288
  // times a day. An empty list is what actually clears it.
  "triggers": { "crons": [] },

  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://hyfcsqrwlolkkxopmcqj.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh5ZmNzcXJ3bG9sa2t4b3BtY3FqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg3MzEwMzcsImV4cCI6MjEwNDMwNzAzN30.VvzM1RAwEjZdDiJLeQWqdmlBefA-bhGMY1283Cnbb5o",
    // The public gallery site has no custom domain yet — method26.com still
    // serves the old WordPress site, so every share link built from that
    // value 404'd. It actually lives at its own workers.dev URL.
    "NEXT_PUBLIC_SITE_URL": "https://method26.com"
  }
}
