{
  "$schema": "node_modules/wrangler/config-schema.json",
  // worker.ts wraps OpenNext's generated handler to add `scheduled` — see the
  // file header. Reverting to ".open-next/worker.js" disables the cron and
  // restores stock OpenNext behaviour.
  "main": "worker.ts",
  "name": "method26-admin",
  // The CRM engine tick + social publish tick. Was a GitHub Action; GitHub
  // throttles scheduled workflows, which stalls onboarding email.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Keep the workers.dev URL alive; add a custom-domain route here when you
  // claim one, e.g. { "pattern": "backend.yourdomain.com", "custom_domain": true }
  "workers_dev": true,
  "compatibility_date": "2026-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // WORKER_SELF_REFERENCE is OpenNext's own cache-revalidation hook and must
  // name THIS worker. The fork also bound FRONTEND_WORKER to
  // "digital-home-frontend", a worker that does not exist on this account and
  // that nothing in src/ references — removed rather than left to fail at
  // deploy or, worse, to bind to somebody else's worker later.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "method26-admin"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Social media files (videos + carousel slides). Make the bucket public by
  // attaching a custom domain (e.g. media.yourdomain.com) and set
  // R2_PUBLIC_BASE below to match — Meta ingests by pulling that URL, and R2
  // egress is free.
  // The fork bound an R2 bucket for the social module, which this fork
  // deleted. An unused binding is a resource somebody must keep existing.
  "r2_buckets": [],
  "observability": {
    "enabled": true
  },
  // Non-secret env vars. Secrets (API keys) are set via `wrangler secret put`.
  // The fork shipped placeholder values here — SUPABASE_URL as
  // "https://your-project.supabase.co", SUPABASE_ANON_KEY as "your-anon-key"
  // — alongside vars for the social and R2 modules this fork deleted.
  //
  // They are removed rather than corrected. `vars` are committed plaintext,
  // which is the wrong home for a project URL that pairs with secret keys,
  // and a placeholder that merely LOOKS configured is worse than an absent
  // one: the app would have deployed pointing at a project that does not
  // exist, and failed at runtime rather than at deploy.
  //
  // Every value now comes from `wrangler secret put`, set by the owner. A
  // missing one fails closed with a configuration error.
  "vars": {}
}
